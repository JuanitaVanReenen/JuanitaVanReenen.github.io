{
  "expo": {
    "name": "Pulza Flow",
    "slug": "pulza-flow",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "pulzaflow",
    "owner": "pulzaflow",
    "extra": {
      "eas": {
        "projectId": "7725c28b-b393-48ed-97fe-041b0de8c114"
      }
    },
    "ios": {
      "bundleIdentifier": "com.pulzaflow.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "PULZA FLOW uses your photo library so you can add images and videos to your Pulzas."
      }
    },
    "android": {
      "package": "com.pulzaflow.app",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ]
    },
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ]
  }
}
